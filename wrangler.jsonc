{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibeplay-live",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./cloudflare-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
